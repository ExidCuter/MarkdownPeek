// Code-signing defaults shared by every target.
//
// Out of the box the build is ad-hoc signed ("Sign to Run Locally"), so the
// repository carries no team ID. Put your own signing identity in
// Config/Local.xcconfig (git-ignored). scripts/install.sh creates that file
// for you from the "Apple Development" certificate in your keychain; see
// Config/Local.xcconfig.example to write it by hand.

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =

#include? "Local.xcconfig"
