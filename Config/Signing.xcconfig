// Code-signing defaults shared by every target.
//
// Builds are ad-hoc signed ("Sign to Run Locally") by default, which is all
// Quick Look needs on your own Mac, and keeps team IDs out of the repository.
// To sign with your own identity instead, copy Config/Local.xcconfig.example
// to Config/Local.xcconfig (git-ignored).

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =

#include? "Local.xcconfig"
